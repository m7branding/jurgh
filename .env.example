# Supabase — vul in vanuit je Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nodig voor het seed-script en voor de Offorte-webhook, die geen ingelogde
# gebruiker heeft en dus langs Row Level Security moet (Settings > API >
# service_role). NOOIT committen of in de client gebruiken.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Offorte — accountnaam is het subdomein van je Offorte-adres.
OFFORTE_ACCOUNT=jurghdetailing
OFFORTE_API_KEY=your-offorte-api-key

# Eigen geheim in de webhook-URL; Offorte ondertekent zijn verzoeken niet.
# De webhook draait op https://<portaal>/api/offorte/webhook?token=<dit geheim>
OFFORTE_WEBHOOK_SECRET=lange-willekeurige-string

# Testfase: klanten uit Offorte krijgen een onbezorgbaar @jurgh.invalid adres
# en herinneringen staan uit. Zet op false zodra je live gaat.
OFFORTE_TEST_MODE=true

# Publiceren naar de klant: in de droogloopstand wordt de inloglink gelogd in
# plaats van gemaild, zodat de flow te testen is zonder mailserver. Zet pas op
# false als er een mailprovider is ingericht (Supabase > Auth > SMTP).
PORTAL_MAIL_DRY_RUN=true

# Resend (later, voor e-mailnotificaties)
# RESEND_API_KEY=
