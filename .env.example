# Supabase — vul in vanuit je Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Alleen nodig voor het seed-script (Settings > API > service_role).
# NOOIT committen of in de client gebruiken.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (later, voor e-mailnotificaties)
# RESEND_API_KEY=
